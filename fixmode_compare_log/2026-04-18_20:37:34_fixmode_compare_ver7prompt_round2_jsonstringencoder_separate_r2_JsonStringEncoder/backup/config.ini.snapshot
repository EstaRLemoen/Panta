[default]
# project home directory
project_directory = defects4j-subjects-notests/JacksonCore-26f

# Path to the source file
source_code_file = defects4j-subjects-notests/JacksonCore-26f/src/main/java/com/fasterxml/jackson/core/io/JsonStringEncoder.java

# Path to the input test file
test_code_file = defects4j-subjects-notests/JacksonCore-26f/src/test/java/com/fasterxml/jackson/core/io/TestJsonStringEncoder.java

# Path to the code coverage report file
code_coverage_report_path = defects4j-subjects-notests/JacksonCore-26f/target/jacoco/jacoco.csv

# The command to run tests and generate coverage report
test_execution_command = mvn clean package -Dtest=TestJsonStringEncoder

test_dependency_command = mvn dependency:list -DexcludeTransitive=true | grep ":test"

junit_version = 4

# The directory to run the test command in
test_code_command_dir = defects4j-subjects-notests/JacksonCore-26f

# LLM models (gpt-4o, gpt-4o-mini, llama3-1, llama3-3) to use
model = gpt-4o-mini

# Optional dedicated model for llm-style advice generation. Falls back to `model` when empty.
llm_path_advice_model =

# Type of coverage report. Default: jacoco
coverage_type = jacoco

# Path to the output report file. Default:test_results.html
report_filepath = fixmode_compare_ver7prompt_round2_jsonstringencoder_separate_r2_20260418_203734.html

# The desired coverage percentage
target_coverage = 100

# The maximum number of iterations to prompt LLM for test generation
maximum_iterations = 18

# The maximum number of iterations without coverage increase
no_coverage_increase_iterations = 3

# Prompt types (baseline, control, coverage)
# baseline: Prompt with only source and test files
# control: Prompt with Control Flow analysis,
# coverage: Prompt with code coverage report
prompt_type = control

# evaluate different path selection algorithm
pick_two_paths = true

# Path selection strategy: comex or llm
selection_mode = llm

# For llm selection mode: before line coverage reaches this percentage,
# skip advice and generate directly from annotated source unless coverage has stalled.
llm_advice_activation_line_coverage = 100

# For llm selection mode: once this many consecutive no-growth iterations are reached,
# switch from direct annotated prompting to advice-guided prompting even below the coverage threshold.
llm_advice_activation_no_growth = 3

llm_path_advice_temperature = 0.2
llm_light_advice_temperature = 0.2

# failed generated tests repair for positive number rounds, 0 means disable repair phase
enable_fixing = 3

# failed test repair mode: combined keeps the current single-prompt behavior,
# separate repairs compilation and runtime failures in two stages.
fixing_mode = separate

# Enable advice feedback: when a no-growth iteration occurs in advice mode, feed
# a summary of the previous round's failed designs/tests back to the next advice prompt.
# Current experiment results do not show a positive effect; keep this disabled
# unless the feedback design is revisited.
enable_advice_feedback = true

# run SymPrompt for evaluation
run_symprompt = false

# Path to the output test file. Default: ""
test_file_output_path =


# Any additional instructions you wish to append at the end of the prompt. Default: ""
additional_instructions =

# List of files to include in the coverage. For example, "--included-files library1.c library2.c." Default: None
included_files =

# CFG Snapshot Configuration
# Enable dumping CFG intermediate results for analysis and debugging
dump_cfg_intermediate = true

# Directory to store CFG snapshots
cfg_dump_dir = cfg_snapshot_test/intermediate/cfg

# Snapshot detail level: "core" (only CFG outputs) or "full" (includes path selection, prompt context)
cfg_dump_level = full

# Prompt storage mode: "summary" (structured metadata only) or "full_text" (complete prompt text)
cfg_dump_prompt_mode = summary

# Artifact Snapshot Configuration
# Enable dumping generated/fixed test artifacts and per-round summaries.
artifact_snapshot_enabled = true

# Directory to store artifact snapshots
artifact_snapshot_dir = artifact_snapshot/intermediate
